<Page x:Class="sQzServer0.Operation0"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:sQzServer0"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1280"
      ShowsNavigationUI="False"
      Title="ExamList">
    <Viewbox>
        <StackPanel x:Name="spMain" Loaded="Main_Loaded" Orientation="Horizontal" Margin="10" Background="#f0f0f0" Height="720" Width="1280">
            <StackPanel Width="400">
                <StackPanel Orientation="Horizontal">
                    <StackPanel>
                        <Button x:Name="btnStart" Width="120" Height="40" Click="btnStart_Click" Background="#1c64e7" Foreground="#fff"
                        Margin="10,20,10,10"/>
                        <Button x:Name="btnStop" Width="120" Height="40" Click="btnStop_Click" Background="#fbbc09" Foreground="#fff"
                        Margin="10,10,10,10" IsEnabled="False"/>
                        <Button x:Name="btnMMenu" Width="120" Height="40" Click="btnMMenu_Click" Background="#f15a23" Foreground="#fff"
                        Margin="10,10,10,20"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="txtDate" HorizontalAlignment="Center" FontSize="14"/>
                        <ListBox x:Name="lbxBrd" Width="200" Height="200" SelectionChanged="lbxBrd_SelectionChanged" Margin="20,0,20,0"/>
                    </StackPanel>
                </StackPanel>
                <Border BorderBrush="Black" BorderThickness="0,1,0,0" Margin="0,20,0,20"/>
                <Grid ShowGridLines="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="txtSubject" Text="Môn kiểm tra" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBox x:Name="tbxSubject" Text="0" Width="100" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                    <TextBlock x:Name="txtDuration" Text="Thời gian kiểm tra (phút)" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBox x:Name="tbxDuration" Text="45" Width="100" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                    <TextBlock x:Name="txtnQs" Text="Số đề kiểm tra" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock x:Name="txtNqs" Text="0" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock x:Name="txtnQ" Text="Số câu hỏi trong một đề" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock x:Name="tbxNq" Text="0" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>
                <TextBlock Text="Tùy chỉnh số câu hỏi trong một đề" HorizontalAlignment="Center" Margin="0,10"/>
                <Grid ShowGridLines="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Dễ" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="Khó" Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="Chỉ chọn 1 đáp án" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="10,0,10,0"/>
                    <TextBox x:Name="tbxSingleAnswerCount" Text="24" Width="40" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <TextBlock Text=" / ??" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"/>
                    <TextBlock Text="0" Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <TextBlock Text=" / 0" Grid.Row="1" Grid.Column="4" VerticalAlignment="Center"/>
                    <TextBlock Text="Chọn đúng/sai ở mỗi ý a, b, c, d" TextWrapping="Wrap" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="10,0,10,0"/>
                    <TextBox x:Name="tbxMTFCount" Text="4" Width="40" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <TextBlock Text=" / ??" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center"/>
                    <TextBlock Text="0" Grid.Row="2" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <TextBlock Text=" / 0" Grid.Row="2" Grid.Column="4" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Name="btnQGen" Content="Tạo đề" Click="btnQGen_Click" Width="120" Height="40" Background="#80cc28" Foreground="#fff" Margin="50,10,0,0"/>
                    <Button Name="btnQSav" Content="Lưu đề" IsEnabled="False" Click="btnQSav_Click" Width="120" Height="40" Background="#fbbc09" Foreground="#fff" Margin="60,10,0,0"/>
                </StackPanel>
            </StackPanel>
            <TabControl Name="tbcSl" Width="876" SelectionChanged="tbcSl_SelectionChanged"/>
            <TabControl Name="tbcRefSl" Width="876" Visibility="Collapsed">
                <TabItem Name="tbiStat" Width="876">
                    <Grid ShowGridLines="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>
                        <TextBlock Name="txtRId" Grid.Column="0" TextAlignment="Center"/>
                        <TextBlock Name="txtRN" Grid.Column="1" TextAlignment="Center"/>
                        <TextBlock Name="txtRT1" Grid.Column="2" TextAlignment="Center"/>
                        <TextBlock Name="txtRT2" Grid.Column="3" TextAlignment="Center"/>
                        <TextBlock Name="txtRQPack" Grid.Column="4" Grid.ColumnSpan="2" TextAlignment="Center" Background="Chartreuse"/>
                        <TextBlock Name="txtQPackR0" Grid.Row="1" Grid.Column="4" TextAlignment="Center"/>
                        <TextBlock Name="txtQPackR1" Grid.Row="1" Grid.Column="5" TextAlignment="Center"/>
                        <TextBlock Name="txtPw" Grid.Column="6" TextAlignment="Center"/>
                    </Grid>
                </TabItem>
                <TabItem Width="876">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                            </Grid.RowDefinitions>
                            <TextBlock Name="txtId" Background="Coral" TextAlignment="Center"/>
                            <TextBlock Name="txtName" Grid.Column="1" Background="Brown" TextAlignment="Center"/>
                            <TextBlock Name="txtBirdate" Grid.Column="2" Background="Cyan" TextAlignment="Center"/>
                            <TextBlock Name="txtBirpl" Grid.Column="3" Background="Gold" TextAlignment="Center"/>
                            <TextBlock Name="txtRoom" Grid.Column="4" Background="Blue" TextAlignment="Center"/>
                            <TextBlock Name="txtGrade" Grid.Column="5" Background="Violet" TextAlignment="Center"/>
                            <TextBlock Name="txtT1" Grid.Column="6" Background="Pink" TextAlignment="Center"/>
                            <TextBlock Name="txtT2" Grid.Column="7" Background="Maroon" TextAlignment="Center"/>
                            <TextBlock Name="txtComp" Grid.Column="8" Background="GreenYellow" TextAlignment="Center"/>
                        </Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Height="600"/>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
    </Viewbox>
</Page>
